#!/usr/bin/env bash

set -euxo pipefail

# ckpool's checked-in Cap'n Proto stubs under ckpool/ipc/mining are generated by
# capnpc 1.1.0 and carry a hard guard, CAPNP_VERSION != 1001000, so they build
# against that version and no other. No Ubuntu release before 25.04 packages it
# (22.04 has 0.8.0, 24.04 has 1.0.1), and an older libcapnp is worse than none:
# configure detects it, enables IPC, and the build then fails on the generated
# code. So build 1.1.0 from source instead of installing the distro package.

# Pin by hash, updates should update both fields
version=1.1.0
sha256=07167580e563f5e821e3b2af1c238c16ec7181612650c5901330fa9a0da50939

if ! capnp --version 2>/dev/null | grep -q "$version"; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT

  wget \
    -O "$tmp/capnproto.tar.gz" \
    https://capnproto.org/capnproto-c++-$version.tar.gz

  echo "$sha256  $tmp/capnproto.tar.gz" | sha256sum --check --strict -

  mkdir -p "$tmp/src"
  tar -xzf "$tmp/capnproto.tar.gz" -C "$tmp/src" --strip-components 1

  pushd "$tmp/src"
  ./configure --prefix=/usr/local
  make -j"$(nproc)"
  make install
  popd

  # /usr/local/lib is on the default search path but the cache needs refreshing
  # before ckpool can link against the new libraries.
  ldconfig

  capnp --version
fi
